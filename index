<script>
  // AppCache masih merupakan cache offline native pada browser PS4. Jangan
  // swap/reload otomatis saat exploit berjalan: update aktif pada navigasi
  // berikutnya dan tidak boleh mencampur module lama dengan asset baru.
  (function () {
    var cacheEl = document.getElementById('cache');
    var ac = window.applicationCache;

    function cacheStatus(text, kind) {
      cacheEl.textContent = text;
      cacheEl.className = kind || '';
    }

    if (!ac) {
      cacheStatus('offline cache unavailable', 'bad');
      return;
    }

    if (navigator.onLine === false) {
      cacheStatus('offline - loaded from cache', 'ok');
    }

    ac.addEventListener('checking', function () {
      cacheStatus('checking offline cache...');
    }, false);
    ac.addEventListener('downloading', function () {
      cacheStatus('saving files for offline use...', 'warn');
    }, false);
    ac.addEventListener('progress', function (event) {
      var suffix = event.total ? ' (' + event.loaded + '/' + event.total + ')' : '';
      cacheStatus('saving offline cache' + suffix, 'warn');
    }, false);
    ac.addEventListener('cached', function () {
      cacheStatus('offline cache ready', 'ok');
    }, false);
    ac.addEventListener('noupdate', function () {
      cacheStatus('offline cache ready', 'ok');
    }, false);
    ac.addEventListener('updateready', function () {
      cacheStatus('cache updated - reload after this run', 'warn');
    }, false);
    ac.addEventListener('obsolete', function () {
      cacheStatus('offline cache obsolete', 'bad');
    }, false);
    ac.addEventListener('error', function () {
      cacheStatus(navigator.onLine === false ?
        'offline cache active' : 'offline cache failed - keep internet connected',
        navigator.onLine === false ? 'ok' : 'bad');
    }, false);
  })();

  // Status chain: beri warna sesuai isi; tampilkan log saat ada kegagalan.
  (function () {
    const stateEl = document.getElementById('state');
    const outEl = document.getElementById('out');
    setInterval(function () {
      const t = stateEl.textContent || '';
      stateEl.className =
        /failed|abort|missing/i.test(t) ? 'bad' :
        /done|running|ok/i.test(t) ? 'ok' :
        /warn|attempt/i.test(t) ? 'warn' : '';
      if (/failed|abort/i.test(t)) outEl.classList.add('visible');
    }, 400);
  })();
</script>
